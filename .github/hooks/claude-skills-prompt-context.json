{
  "version": 1,
  "hooks": {
    "UserPromptSubmit": [
      {
        "type": "command",
        "powershell": "$body = [Console]::In.ReadToEnd(); try { Invoke-WebRequest -UseBasicParsing -Uri 'http://127.0.0.1:4895/hook/prompt-context?agent=copilot&cwd=c%3A%5CUsers%5CJEANPC%5CChat-IA' -Method POST -Headers @{ 'Content-Type' = 'application/json' } -Body $body | Out-Null } catch { }",
        "timeoutSec": 8
      }
    ],
    "userPromptSubmitted": [
      {
        "type": "command",
        "powershell": "$body = [Console]::In.ReadToEnd(); try { Invoke-WebRequest -UseBasicParsing -Uri 'http://127.0.0.1:4895/hook/prompt-context?agent=copilot&cwd=c%3A%5CUsers%5CJEANPC%5CChat-IA' -Method POST -Headers @{ 'Content-Type' = 'application/json' } -Body $body | Out-Null } catch { }",
        "timeoutSec": 8
      }
    ]
  }
}
