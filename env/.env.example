# ============================================================
# Chat IA — configuração de ambiente
# Copie para env/.env  (gitignored) e preencha suas chaves:
#   cp env/.env.example env/.env
# O servidor carrega automaticamente env/.env ao iniciar.
# ============================================================

# ---- Servidor ----
PORT=7788
LAUNCHER_URL=http://127.0.0.1:7777

# ---- Ollama (local, sem chave) ----
OLLAMA_URL=http://127.0.0.1:11434

# ---- DeepSeek (V3 e R1 Reasoning) ----
# DEEPSEEK_API_KEY=sk-...

# ---- OpenAI ----
# OPENAI_API_KEY=sk-...

# ---- Anthropic (Claude) ----
# ANTHROPIC_API_KEY=sk-ant-...

# ---- Google Gemini ----
# GEMINI_API_KEY=AIza...

# ---- OpenRouter (agregador: Claude, GPT, Llama, etc.) ----
# OPENROUTER_API_KEY=sk-or-...

# ---- Groq (ultra-rápido, Llama/Qwen/Whisper) ----
# GROQ_API_KEY=gsk_...

# ---- RAG & Embeddings ----
# Provedor de embeddings: ollama, gemini, openai ou local (padrão: auto)
# EMBEDDING_PROVIDER=ollama
# EMBEDDING_MODEL=nomic-embed-text

# ---- Web Search (Opcional - DuckDuckGo é nativo sem chave) ----
# TAVILY_API_KEY=tvly-...