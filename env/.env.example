# ============================================================
# Chat IA — configuração de ambiente
# Copie para env/.env  (gitignored) e preencha suas chaves:
#   cp env/.env.example env/.env
# O servidor carrega automaticamente env/.env ao iniciar.
# ============================================================

# ---- Servidor ----
PORT=7789
LAUNCHER_URL=http://127.0.0.1:7777

# ---- Ollama (local, sem chave) ----
OLLAMA_URL=http://127.0.0.1:11434

# ---- OpenAI ----
# OPENAI_API_KEY=sk-...

# ---- Anthropic (Claude) ----
# ANTHROPIC_API_KEY=sk-ant-...

# ---- Google Gemini ----
# GEMINI_API_KEY=AIza...

# ---- OpenRouter (agregador: Claude, GPT, Llama, etc.) ----
# OPENROUTER_API_KEY=sk-or-...

# ---- Groq (ultra-rápido, Llama/Qwen) ----
# GROQ_API_KEY=gsk_...