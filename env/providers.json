{
  "default": "ollama",
  "providers": {
    "ollama": {
      "label": "Ollama (Local)",
      "baseUrl": "http://127.0.0.1:11434",
      "models": ["qwen3.5:4b"]
    },
    "ollama-cloud": {
      "label": "Ollama Cloud",
      "baseUrl": "https://ollama.com/api",
      "envKey": "OLLAMA_API_KEY",
      "models": [
        "glm-5.3",
        "glm-5.3-flash",
        "kimi-k3",
        "kimi-k2.7-code",
        "kimi-k2.6",
        "deepseek-v4.1-flash",
        "deepseek-v4-pro:0813",
        "gpt-oss:120b",
        "gpt-oss:20b",
        "minimax-m3",
        "minimax-m3.1-flash",
        "mistral-large-4",
        "gemma4:31b",
        "nemotron-3-super",
        "nemotron-3-ultra",
        "clef:27b"
      ]
    },
    "openai": {
      "label": "OpenAI",
      "baseUrl": "https://api.openai.com/v1",
      "envKey": "OPENAI_API_KEY",
      "models": ["gpt-4o", "gpt-4o-mini", "gpt-4.1", "o4-mini"]
    },
    "anthropic": {
      "label": "Anthropic Claude",
      "baseUrl": "https://api.anthropic.com/v1",
      "envKey": "ANTHROPIC_API_KEY",
      "models": ["claude-sonnet-5", "claude-opus-4-1", "claude-haiku-4-5"]
    },
    "gemini": {
      "label": "Google Gemini",
      "baseUrl": "https://generativelanguage.googleapis.com/v1beta",
      "envKey": "GEMINI_API_KEY",
      "models": ["gemini-2.5-pro", "gemini-2.5-flash"]
    },
    "openrouter": {
      "label": "OpenRouter",
      "baseUrl": "https://openrouter.ai/api/v1",
      "envKey": "OPENROUTER_API_KEY",
      "models": ["anthropic/claude-sonnet-5", "openai/gpt-4o", "meta-llama/llama-3.1-70b-instruct"]
    },
    "groq": {
      "label": "Groq",
      "baseUrl": "https://api.groq.com/openai/v1",
      "envKey": "GROQ_API_KEY",
      "models": ["llama-3.3-70b-versatile", "qwen/qwen3-32b"]
    },
    "nvidia": {
      "label": "NVIDIA (free endpoints)",
      "baseUrl": "https://integrate.api.nvidia.com/v1",
      "envKey": "NVIDIA_API_KEY",
      "models": ["nvidia/nemotron-3-ultra-550b-a55b", "nvidia/nemotron-3.5-lightning-30b-a3b"]
    },
    "deepseek": {
      "label": "DeepSeek",
      "baseUrl": "https://api.deepseek.com",
      "envKey": "DEEPSEEK_API_KEY",
      "models": ["deepseek-chat", "deepseek-reasoner"]
    }
  }
}